# AI Trade Workbench 环境配置 —— 复制为 .env 后填写（.env 已 gitignore，永不提交）

# 管理密码初始值（首次启动生成数据时生效；之后改密走设置页）
# ADMIN_PASSWORD=admin123

# ── Gmail 询盘管道（W3）────────────────────────────
# 1) Google 账号开启两步验证：myaccount.google.com/security
# 2) 生成「应用密码」：myaccount.google.com/apppasswords（16 位，粘贴时去掉空格）
# 3) 填下面两行，重启工作台即自动拉取（默认每 15 分钟）
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 轮询间隔（分钟，可选）
GMAIL_POLL_MINUTES=15

# ── P1 · LLM 分诊（可选；不填=纯规则模式）──────────
# 任何 OpenAI 兼容端点均可：OpenAI / DeepSeek / GLM / 本地 Ollama
# 例：GLM   LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4.6
# 例：DeepSeek  LLM_API_BASE=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
